<h3 id="代码高亮shiki" tabindex="-1">代码高亮（Shiki）</h3>
<pre><code class="language-ts">// TypeScript 示例
interface User {
  name: string;
  age: number;
}

export function greet(user: User): string {
  return \`你好，\${user.name}！\`;
}
</code></pre>
<pre><code class="language-python"># Python 示例
def fib(n: int) -&gt; int:
    return n if n &lt; 2 else fib(n - 1) + fib(n - 2)

print([fib(i) for i in range(10)])
</code></pre>
